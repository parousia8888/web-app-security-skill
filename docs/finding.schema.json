{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/parousia8888/web-app-security-skill/main/docs/finding.schema.json",
  "title": "Web App Security Skill finding",
  "type": "object",
  "required": ["schemaVersion", "id", "fingerprint", "ruleId", "title", "severity", "state", "summary", "evidence", "remediation", "retest", "baselineState"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ruleId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "title": { "type": "string" },
    "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
    "state": { "enum": ["confirmed", "suspected", "unknown", "not_applicable"] },
    "summary": { "type": "string" },
    "location": {
      "type": ["object", "null"],
      "properties": {
        "path": { "type": "string" },
        "line": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "evidence": { "type": "object" },
    "remediation": { "type": "string" },
    "retest": { "type": "string" },
    "baselineState": { "enum": ["new", "fixed", "unchanged", "regressed", null] }
  }
}
