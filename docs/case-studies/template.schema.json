{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/parousia8888/web-app-security-skill/main/docs/case-studies/template.schema.json",
  "title": "Web App Security Skill public case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "project",
    "source",
    "authorizationBoundary",
    "evidence",
    "falsePositiveClosures",
    "patch",
    "retest",
    "disclosure",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "hostedInstanceProbed", "networkDenied"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "hostedInstanceProbed": { "type": "boolean" },
        "networkDenied": { "type": "boolean" }
      }
    },
    "authorizationBoundary": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "state", "summary", "locations"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "state": { "enum": ["confirmed", "suspected", "unknown", "not_applicable"] },
          "summary": { "type": "string", "minLength": 1 },
          "locations": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "falsePositiveClosures": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": { "enum": ["not_required", "proposed", "applied_locally", "applied_upstream"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "retest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "summary"],
      "properties": {
        "result": { "enum": ["fixed", "unchanged", "regressed", "not_run"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "upstreamResponse", "publicAuthorization"],
      "properties": {
        "state": { "enum": ["not_required", "private_draft", "reported_privately", "coordinated_public", "public_by_upstream"] },
        "upstreamResponse": { "type": "string" },
        "publicAuthorization": { "type": "boolean" }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": { "state": { "const": "suspected" } },
              "required": ["state"]
            }
          }
        }
      },
      "then": {
        "properties": {
          "disclosure": {
            "properties": {
              "state": { "enum": ["coordinated_public", "public_by_upstream"] },
              "publicAuthorization": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disclosure": {
            "properties": {
              "state": { "enum": ["private_draft", "reported_privately"] }
            },
            "required": ["state"]
          }
        }
      },
      "then": {
        "properties": {
          "disclosure": {
            "properties": { "publicAuthorization": { "const": false } }
          }
        }
      }
    }
  ]
}
