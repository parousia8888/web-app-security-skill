{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/parousia8888/web-app-security-skill/main/docs/security-scope.schema.json",
  "title": "Web App Security Skill scope",
  "type": "object",
  "required": ["schemaVersion", "generatedBy", "generatedAt", "subject", "auditBoundary", "run", "target", "authorization", "checkModes", "discoveryEvidence", "exclusions"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "generatedBy": {
      "type": "object",
      "required": ["product", "version"],
      "properties": {
        "product": { "const": "Web App Security Skill" },
        "version": { "type": "string" }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "binding", "scopeDigest", "localPathIncluded"],
      "properties": {
        "id": { "type": "string", "pattern": "^project-[a-f0-9]{32}$" },
        "binding": { "enum": ["persisted", "ephemeral"] },
        "scopeDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "localPathIncluded": { "const": false }
      }
    },
    "auditBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sourceRoots", "excludedDirectories", "checkModes", "networkAccess", "traversalLimits"],
      "properties": {
        "version": { "const": 2 },
        "sourceRoots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/projectRelativeRoot" } },
        "excludedDirectories": { "type": "array", "items": { "$ref": "#/$defs/projectRelativePath" } },
        "checkModes": { "type": "array", "items": { "enum": ["source", "local", "adapter:checkov", "adapter:gitleaks", "adapter:opengrep", "adapter:osv"] } },
        "networkAccess": { "type": "boolean" },
        "adapters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["builtin", "checkov", "gitleaks", "opengrep", "osv"] }
        },
        "adapterTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "traversalLimits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxDepth", "maxFiles", "maxEntries", "maxFileBytes"],
          "properties": {
            "maxDepth": { "type": "integer", "minimum": 1, "maximum": 64 },
            "maxFiles": { "type": "integer", "minimum": 1, "maximum": 200000 },
            "maxEntries": { "type": "integer", "minimum": 1, "maximum": 500000 },
            "maxFileBytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "required": ["id", "directory"],
      "properties": {
        "id": { "type": "string" },
        "directory": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "required": ["projectRoot", "discoveryStatus", "layout", "frameworks", "packageManagers", "manifests", "lockfiles", "deploymentSurfaces", "configSurfaces", "publicOrigins"],
      "properties": {
        "projectRoot": { "$ref": "#/$defs/canonicalAbsolutePath" },
        "discoveryStatus": { "enum": ["supported", "ambiguous", "unsupported"] },
        "layout": { "enum": ["single-root", "monorepo", "split-stack"] },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["root"],
            "properties": { "root": { "$ref": "#/$defs/projectRelativeRoot" } }
          }
        },
        "packageManagers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["root"],
            "properties": { "root": { "$ref": "#/$defs/projectRelativeRoot" } }
          }
        },
        "manifests": { "type": "array", "items": { "$ref": "#/$defs/projectRelativePath" } },
        "lockfiles": { "type": "array", "items": { "$ref": "#/$defs/projectRelativePath" } },
        "deploymentSurfaces": { "type": "array", "items": { "$ref": "#/$defs/projectRelativePath" } },
        "configSurfaces": { "type": "array", "items": { "$ref": "#/$defs/projectRelativePath" } },
        "publicOrigins": { "type": "array" }
      }
    },
    "authorization": {
      "type": "object",
      "required": ["status", "basis", "proof", "note"],
      "properties": {
        "status": { "enum": ["pending", "granted", "denied"] }
      }
    },
    "checkModes": {
      "type": "object",
      "required": ["source", "local", "remotePassive", "remoteActive"]
    },
    "discoveryEvidence": {
      "type": "object",
      "required": ["examinedFiles", "networkAccessPerformed", "secretFilesRead", "warnings", "unknowns"],
      "properties": {
        "networkAccessPerformed": { "const": false },
        "secretFilesRead": { "const": false }
      }
    },
    "exclusions": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "canonicalAbsolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/(?!\\.{1,2}(?:/|$))(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\u0000-\\u001f\\u007f]*$",
      "description": "Canonical absolute project root. Runtime validation additionally applies the host platform path resolver."
    },
    "projectRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!\\.{1,2}$)(?!\\.{1,2}/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+$",
      "description": "Normalized project-relative path without traversal, backslashes or control characters."
    },
    "projectRelativeRoot": {
      "anyOf": [
        { "const": "." },
        { "$ref": "#/$defs/projectRelativePath" }
      ]
    }
  }
}
